<Window x:Class="RentManager.Views.IncidenciaForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incidencia"
        Height="540" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTituloVentana"
                   Text="Nueva incidencia"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Vivienda"/>
            <ComboBox x:Name="cmbVivienda"
                      Grid.Row="1"
                      Margin="0,0,0,10"
                      DisplayMemberPath="Direccion"
                      SelectedValuePath="IdVivienda"/>

            <TextBlock Text="Título" Grid.Row="2"/>
            <TextBox x:Name="txtTitulo" Grid.Row="3" Margin="0,0,0,10"/>

            <TextBlock Text="Descripción" Grid.Row="4"/>
            <TextBox x:Name="txtDescripcion"
                     Grid.Row="5"
                     Height="70"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Margin="0,0,0,10"/>

            <TextBlock Text="Fecha" Grid.Row="6"/>
            <DatePicker x:Name="dpFecha" Grid.Row="7" Margin="0,0,0,10"/>

            <TextBlock Text="Estado" Grid.Row="8"/>
            <ComboBox x:Name="cmbEstado" Grid.Row="9" Margin="0,0,0,10">
                <ComboBoxItem Content="Abierta"/>
                <ComboBoxItem Content="EnProceso"/>
                <ComboBoxItem Content="Resuelta"/>
            </ComboBox>

            <TextBlock Text="Coste estimado" Grid.Row="10"/>
            <TextBox x:Name="txtCoste" Grid.Row="11" Margin="0,0,0,10"/>

            <TextBlock Text="Observaciones" Grid.Row="12"/>
            <TextBox x:Name="txtObservaciones"
                     Grid.Row="13"
                     Height="60"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"/>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancelar"
                    Click="BtnCancelar_Click"
                    Margin="0,0,10,0"
                    MinWidth="90"/>

            <Button Content="Guardar"
                    Click="BtnGuardar_Click"
                    MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>