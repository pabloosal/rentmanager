<Window x:Class="RentManager.Views.ContratoForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contrato"
        Height="560" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitulo"
                   Text="Nuevo contrato"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Vivienda"/>
            <ComboBox x:Name="cmbVivienda" Grid.Row="1" Margin="0,0,0,10"/>

            <TextBlock Text="Inquilino" Grid.Row="2"/>
            <ComboBox x:Name="cmbInquilino" Grid.Row="3" Margin="0,0,0,10"/>

            <TextBlock Text="Fecha inicio" Grid.Row="4"/>
            <DatePicker x:Name="dpInicio" Grid.Row="5" Margin="0,0,0,10"/>

            <TextBlock Text="Fecha fin (opcional)" Grid.Row="6"/>
            <DatePicker x:Name="dpFin" Grid.Row="7" Margin="0,0,0,10"/>

            <TextBlock Text="Renta mensual" Grid.Row="8"/>
            <TextBox x:Name="txtRenta" Grid.Row="9" Margin="0,0,0,10"/>

            <TextBlock Text="Fianza (opcional)" Grid.Row="10"/>
            <TextBox x:Name="txtFianza" Grid.Row="11" Margin="0,0,0,10"/>

            <TextBlock Text="Estado" Grid.Row="12"/>
            <ComboBox x:Name="cmbEstado" Grid.Row="13" Margin="0,0,0,10">
                <ComboBoxItem Content="Activo"/>
                <ComboBoxItem Content="Finalizado"/>
            </ComboBox>

            <TextBlock Text="Observaciones" Grid.Row="14"/>
            <TextBox x:Name="txtObservaciones"
                     Grid.Row="15"
                     Height="70"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"/>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancelar" Click="BtnCancelar_Click" Margin="0,0,10,0" MinWidth="90"/>
            <Button Content="Guardar" Click="BtnGuardar_Click" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
