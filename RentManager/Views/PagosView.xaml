<UserControl x:Class="RentManager.Views.PagosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#2D6CDF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2D6CDF"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Gestión de Pagos"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Filtros + acciones -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E2E2E2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Contrato"/>
                    <ComboBox x:Name="cmbContrato" Height="32" SelectionChanged="Filtros_Changed"
                              DisplayMemberPath="Texto" SelectedValuePath="IdContrato"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Año"/>
                    <TextBox x:Name="txtAnyo" Height="32" VerticalContentAlignment="Center" TextChanged="Filtros_Changed"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="Estado"/>
                    <ComboBox x:Name="cmbEstado" Height="32" SelectionChanged="Filtros_Changed">
                        <ComboBoxItem Content="Todos" IsSelected="True"/>
                        <ComboBoxItem Content="Pendiente"/>
                        <ComboBoxItem Content="Pagado"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="10,0,0,0">
                    <Button Content="Generar meses" Style="{StaticResource PrimaryButtonStyle}" Click="BtnGenerar_Click"/>
                    <Button Content="Marcar pagado" Style="{StaticResource ActionButtonStyle}" Click="BtnMarcarPagado_Click"/>
                    <Button Content="Eliminar" Style="{StaticResource ActionButtonStyle}" Click="BtnEliminar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabla -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E2E2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">

            <DataGrid x:Name="dgPagos"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="None"
                      RowHeaderWidth="0"
                      CanUserAddRows="False">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Vivienda" Binding="{Binding ViviendaDireccion}" Width="2*"/>
                    <DataGridTextColumn Header="Inquilino" Binding="{Binding InquilinoNombreCompleto}" Width="2*"/>
                    <DataGridTextColumn Header="Mes" Binding="{Binding Mes}" Width="*"/>
                    <DataGridTextColumn Header="Año" Binding="{Binding Anyo}" Width="*"/>
                    <DataGridTextColumn Header="Importe" Binding="{Binding Importe}" Width="*"/>
                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="*"/>
                    <DataGridTextColumn Header="Fecha pago" Binding="{Binding FechaPago}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
